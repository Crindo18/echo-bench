# Never commit data, models, results or reports (blueprint sections 4.7 and 5).
# Anything holding participant recordings or results is restricted data.
# The leading / anchors these to the repository root, so code packages that happen
# to be called data/ (echo_bench/data) are still committed.
/data/
/artifacts/
/results/
/reports/
# Licensed corpora and any recordings: never committed, even if kept inside this folder.
/corpora/
*.wav
*.flac
*.db
*.db-wal
*.db-shm
*.onnx
practice_artifacts/

# Python and tool caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
dist/
